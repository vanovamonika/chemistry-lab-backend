{
  "name": "chemistry-lab-backend",
  "version": "1.0.0",
  "description": "Backend for Virtual Chemistry Lab",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:drop": "rm -f sqlite.db && rm -rf ./src/db/migrations",
    "db:reset": "npm run db:drop && npm run db:generate && npm run db:migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "docs": "typedoc src/routes/authRoutes.ts --out docs --entryPointStrategy expand",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "chemistry",
    "lab",
    "education",
    "drizzle",
    "sqlite"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^9.6.0",
    "chalk": "^5.6.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.1",
    "express": "^4.22.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^6.4.14",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.7",
    "drizzle-kit": "^0.31.9",
    "jest": "^30.3.0",
    "jsdoc": "^4.0.5",
    "ts-jest": "^29.4.6",
    "tsx": "^4.9.1",
    "typedoc": "^0.28.17",
    "typescript": "^5.3.3"
  }
}
